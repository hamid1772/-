# =========================================================

def show_books():

    for item in books_tree.get_children():

        books_tree.delete(item)


    books = get_all_books()


    for book in books:

        books_tree.insert(
            "",
            "end",
            values=book
        )


# =========================================================
# SELECT BOOK
# =========================================================

def select_book(event):

    global selected_book_id

    selected = books_tree.selection()

    if not selected:

        return


    item = books_tree.item(
        selected[0]
    )

    values = item["values"]


    selected_book_id = values[0]


    title_entry.delete(
        0,
        tk.END
    )

    author_entry.delete(
        0,
        tk.END
    )

    year_entry.delete(
        0,
        tk.END
    )

    stock_entry.delete(
        0,
        tk.END
    )


    title_entry.insert(
        0,
        values[1]
    )

    author_entry.insert(
        0,
        values[2]
    )

    year_entry.insert(
        0,
        values[3]
    )

    stock_entry.insert(
        0,
        values[4]
    )


books_tree.bind(
    "<ButtonRelease-1>",
    select_book
)


# =========================================================
# ADD BOOK
# =========================================================

def add_book_gui():

    title = title_entry.get().strip()

    author = author_entry.get().strip()

    year = year_entry.get().strip()

    stock = stock_entry.get().strip()


    if not title or not author or not year or not stock:

        messagebox.showerror(
            "Error",
            "Please fill all book fields"
        )

        return


    try:

        year = int(year)

        stock = int(stock)

    except ValueError:

        messagebox.showerror(
            "Error",
            "Year and stock must be numbers"
        )

        return


    if year < 0:

        messagebox.showerror(
            "Error",
            "Year cannot be negative"
        )

        return


    if stock < 0:

        messagebox.showerror(
            "Error",
            "Stock cannot be negative"
        )

        return


    success, message = add_book(
        title,
        author,
        year,
        stock
    )


    if success:

        messagebox.showinfo(
            "Success",
            message
        )

        clear_book_entries()

        show_books()

        load_books()

    else:

        messagebox.showerror(
            "Error",
            message
        )


# =========================================================
# UPDATE BOOK
# =========================================================

def update_book_gui():

    global selected_book_id


    if selected_book_id is None:

        messagebox.showerror(
            "Error",
            "Please select a book"
        )

        return


    title = title_entry.get().strip()

    author = author_entry.get().strip()

    year = year_entry.get().strip()

    stock = stock_entry.get().strip()


    if not title or not author or not year or not stock:

        messagebox.showerror(
            "Error",
            "Please fill all fields"
        )

        return


    try:

        year = int(year)

        stock = int(stock)

    except ValueError:

        messagebox.showerror(
            "Error",
            "Year and stock must be numbers"
        )

        return


    if year < 0 or stock < 0:

        messagebox.showerror(
            "Error",
            "Year and stock cannot be negative"
        )

        return


    success, message = update_book(
        selected_book_id,
        title,
        author,
        year,
        stock
    )


    if success:

        messagebox.showinfo(
            "Success",
            message
        )

        show_books()

        load_books()

    else:

        messagebox.showerror(
            "Error",
            message
        )


# =========================================================
# DELETE BOOK
# =========================================================

def delete_book_gui():

    global selected_book_id


    if selected_book_id is None:

        messagebox.showerror(
            "Error",
            "Please select a book"
        )

        return


    confirm = messagebox.askyesno(
        "Confirm",
        "Delete selected book?"
    )


    if not confirm:

        return


    success, message = delete_book(
        selected_book_id
    )


    if success:

        messagebox.showinfo(
            "Success",
            message
        )

        clear_book_entries()

        show_books()

        load_books()

        selected_book_id = None

    else:

        messagebox.showerror(
            "Error",
            message
        )


