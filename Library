# =========================================================
# BORROW BOOK
# =========================================================

def borrow_book_gui():

    selected_member = member_combo.get()

    selected_book = book_combo.get()


    if not selected_member or not selected_book:

        messagebox.showerror(
            "Error",
            "Please select member and book"
        )

        return


    member_id = member_map[
        selected_member
    ]

    book_id = book_map[
        selected_book
    ]


    success, message = borrow_book(
        member_id,
        book_id
    )


    if success:

        messagebox.showinfo(
            "Success",
            message
        )

        load_books()

        load_borrowings()

        show_books()

        show_borrowings()

    else:

        messagebox.showerror(
            "Error",
            message
        )


