def load_borrowings():

    global borrowing_map

    borrowings = get_active_borrowings()


    borrowing_map = {}

    display_values = []


    for borrowing in borrowings:

        borrowing_id = borrowing[0]

        member_name = borrowing[1]

        book_title = borrowing[2]


        text = (
            f"{member_name} - "
            f"{book_title}"
        )


        borrowing_map[text] = borrowing_id

        display_values.append(text)


    borrowing_combo["values"] = display_values


